{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "blue": "{{colors.blue}}", "green": "{{colors.green}}", "yellow": "{{colors.yellow}}",
    "red": "{{colors.red}}", "mauve": "{{colors.mauve}}", "peach": "{{colors.peach}}",
    "teal": "{{colors.teal}}", "sky": "{{colors.sky}}", "overlay": "{{colors.overlay}}",
    "text": "{{colors.text}}", "subtext": "{{colors.subtext}}", "surface": "{{colors.surface}}",
    "surfaceHigh": "{{colors.surface_high}}", "base": "{{colors.base}}",
    "mantle": "{{colors.mantle}}", "crust": "{{colors.crust}}"
  },
  "theme": {
    "primary": "blue", "secondary": "mauve", "accent": "peach",
    "error": "red", "warning": "yellow", "success": "green", "info": "sky",
    "text": "text", "textMuted": "subtext",
    "background": "base", "backgroundPanel": "mantle", "backgroundElement": "surface",
    "border": "surface", "borderActive": "blue", "borderSubtle": "crust",
    "diffAdded": "green", "diffRemoved": "red", "diffContext": "subtext",
    "diffHunkHeader": "mauve", "diffHighlightAdded": "green", "diffHighlightRemoved": "red",
    "diffAddedBg": "surface", "diffRemovedBg": "surface", "diffContextBg": "base",
    "diffLineNumber": "overlay", "diffAddedLineNumberBg": "surface", "diffRemovedLineNumberBg": "surface",
    "markdownText": "text", "markdownHeading": "mauve", "markdownLink": "blue",
    "markdownLinkText": "sky", "markdownCode": "green", "markdownBlockQuote": "subtext",
    "markdownEmph": "yellow", "markdownStrong": "peach", "markdownHorizontalRule": "overlay",
    "markdownListItem": "blue", "markdownListEnumeration": "sky", "markdownImage": "blue",
    "markdownImageText": "sky", "markdownCodeBlock": "text",
    "syntaxComment": "overlay", "syntaxKeyword": "mauve", "syntaxFunction": "blue",
    "syntaxVariable": "text", "syntaxString": "green", "syntaxNumber": "peach",
    "syntaxType": "yellow", "syntaxOperator": "sky", "syntaxPunctuation": "subtext"
  }
}
