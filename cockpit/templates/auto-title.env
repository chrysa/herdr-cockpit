# herdr.auto-title settings, installed by cockpit setup to ~/.config/herdr-auto-title/config.env
# Compact tab titles: no agent name (agents are auto-named), no position (prefix+1..9 shows it).
HERDR_AUTO_TITLE_AGENT_NAME=false
HERDR_AUTO_TITLE_POSITION=false
HERDR_AUTO_TITLE_MAX_LENGTH=28
HERDR_AUTO_TITLE_BRANCH_MAX=10
