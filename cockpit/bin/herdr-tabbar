#!/usr/bin/env sh
# Right side of herdr's tab bar (ui.tab_bar_right, type = "command"):
# account · model · plan window/context of the focused agent. chrysa.agent-info
# writes the line on every focus or status change; reading a file keeps this
# under herdr's command timeout (querying herdr from here timed out under load).
# Prints nothing outside an agent or while agent-info is not running.
cat "$HOME/.local/state/chrysa.agent-info/tabbar" 2>/dev/null
exit 0
